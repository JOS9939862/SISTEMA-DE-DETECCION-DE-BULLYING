# Copia este archivo como .env (en backend/ o en la raíz del proyecto) y completa los valores.

# --- Base de datos MySQL ---
DB_USER=usuario
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nombre_bd

# --- Seguridad ---
# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MIN=480

# Orígenes del frontend autorizados (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Inteligencia artificial (opcional) ---
# Sin IA configurada, el sistema usa el análisis por reglas.
# Opción A: Claude (Anthropic)
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-sonnet-5-5
# Opción B: cualquier API compatible con OpenAI (Ollama local, Groq, OpenRouter...)
#   Con Ollama los textos de las denuncias no salen del equipo.
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=

# Ajustes de velocidad (útiles con modelos locales lentos)
LLM_MAX_TOKENS=900
# Segundos de espera por respuesta (un modelo local solo con CPU puede tardar minutos)
LLM_TIMEOUT=600
RAG_K=3
RAG_MAX_CHARS=600
