# =====================================================================
# Plantilla de variables de entorno - Sistema de Deteccion de Bullying
# =====================================================================
# Copia este archivo como .env y rellena los valores reales:
#     Windows (CMD):        copy .env.example .env
#     Windows (PowerShell): Copy-Item .env.example .env
#     Linux / macOS:        cp .env.example .env
#
# El archivo .env esta en .gitignore y NUNCA debe subirse al repo.
# Las credenciales reales se comparten por el grupo del equipo.
# =====================================================================

# --- Base de datos (MySQL de Laragon) ---
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bullying_db
DB_USER=bullying_user
DB_PASSWORD=CAMBIAR_ESTA_PASSWORD
DB_CHARSET=utf8mb4

# --- Cadena de conexion para SQLAlchemy / FastAPI ---
DATABASE_URL=mysql+pymysql://bullying_user:CAMBIAR_ESTA_PASSWORD@127.0.0.1:3306/bullying_db?charset=utf8mb4
